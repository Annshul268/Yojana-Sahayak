# Application Configuration
APP_ENV=development
DEBUG=true
PROJECT_NAME="Yojana Sahayak"
API_V1_STR="/api"

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# PostgreSQL Database (Phase 2)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yojana_sahayak

# Supabase Auth & Storage (Phase 2)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ChromaDB Vector Store (Phase 7)
# CHROMA_PERSIST_DIRECTORY=./chroma_data

# Groq LLM API (Phase 8)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# Government Open Data API (Phase 4)
# DATAGOV_API_KEY=your_datagov_api_key_here
